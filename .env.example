# Bu dosyayı .env olarak kopyalayıp gerçek saha verisiyle kalibre edilmiş
# değerlerle doldurun. Buradaki her satır, config/warehouse.php'deki bir
# varsayılanı GEÇERSİZ KILAR — kod değiştirmeden.
#
# .env dosyasının kendisi (.env.example DEĞİL) asla versiyon kontrolüne
# eklenmemelidir (bkz. .gitignore) — gerçek üretim eşikleri, saha
# operasyonuna dair hassas bilgi sayılabilir.

# ── ÜRETİMDE ZORUNLU (EnvValidator::validateOrDie() bunları kontrol eder) ──
# Eksik/zayıfsa sistem GÜVENLİ ŞEKİLDE (açık hatayla) BAŞLAMAZ.
EVENT_STORE_HMAC_KEY_V1=  # en az 32 karakter, rastgele üretilmeli (bin2hex(random_bytes(32)))
DB_HOST=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Harici Hata Raporlama (Sentry vb. — opsiyonel, boşsa yerel kuyruğa düşer) ──
SENTRY_DSN=

# AŞAMA 2: Zimmet Zaman Aşımı — dakika
DWELL_TIME_WINDOW_MINUTES=15

# AŞAMA 4: Raf/Ürün Sıralı Okutma penceresi — saniye
SCAN_SEQUENCE_WINDOW_SECONDS=120

# v1.1: Süpervizör Suistimal Önleme Eşiği
SUPERVISOR_VELOCITY_WINDOW_MINUTES=60
SUPERVISOR_VELOCITY_THRESHOLD=5

# Cihaz Arıza Tespiti
DEVICE_FAULT_WINDOW_MINUTES=10
DEVICE_FAULT_THRESHOLD=5

# Ağırlık Toleransı (0.10 = %10)
WEIGHT_TOLERANCE_FRACTION=0.10

# Risk Skorlama Eşikleri
RISK_THRESHOLD_HIGH=60.0
RISK_THRESHOLD_MEDIUM=25.0
RISK_WINDOW_DAYS=90

# Kesin SKT Blokajı — varsayılan minimum gün
EXPIRY_LOCKOUT_DEFAULT_MIN_DAYS=0

# Kargo teyidi bekleme eşiği — saat
CARRIER_CONFIRMATION_HOURS=48

# EventStore: eşzamanlılık çakışması retry sınırı
EVENT_STORE_MAX_RETRY_ATTEMPTS=5
